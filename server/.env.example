# Server Environment Configuration Template
PORT=5000
NODE_ENV=development

# Frontend Client Origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/taskflow
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/taskflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow

# JWT Authentication Configuration
# Provide a strong, high-entropy secret string for signing JWT tokens in production
JWT_SECRET=your_jwt_secret_key_change_in_production
# Token lifetime (e.g. 1h, 24h, 7d)
JWT_EXPIRES_IN=1h
