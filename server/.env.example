# ========================================================
# TaskFlow Server Environment Configuration
# ========================================================

# Server Port (Render sets this dynamically, defaults to 5000 locally)
PORT=5000
NODE_ENV=development

# Frontend Client Origin (for CORS)
# Local: http://localhost:5173
# Production (Render): URL of your deployed Vercel frontend, e.g.:
# CLIENT_ORIGIN=https://your-taskflow.vercel.app
# Multiple origins can be comma-separated: http://localhost:5173,https://your-taskflow.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/taskflow
# Production (Atlas): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/taskflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow

# JWT Authentication Configuration
# Provide a strong, high-entropy secret string (min 32 characters) in production
JWT_SECRET=your_jwt_secret_key_change_in_production
# Token lifetime (e.g. 1h, 24h, 7d)
JWT_EXPIRES_IN=7d
