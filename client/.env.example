# ========================================================
# TaskFlow Client Environment Variables
# ========================================================

# In local development:
# Leave blank to use Vite's internal development proxy (/api -> http://localhost:5000)
# VITE_API_URL=

# In production (e.g., deployed on Vercel):
# Set this to the public URL of your deployed Express backend on Render:
# VITE_API_URL=https://taskmanager-nod4.onrender.com
